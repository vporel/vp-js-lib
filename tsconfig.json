{
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"moduleResolution": "node10",
		"allowSyntheticDefaultImports": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"declaration": true,
		"outDir": "./dist"
	},
	"include": ["misc/src"],
	"exclude": ["node_modules", "*/node_modules", "**/*.spec.ts", "**/*.test.ts"]
}
